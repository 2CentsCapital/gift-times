# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server/ingest only — never expose
SUPABASE_ANON_KEY=your-anon-key

# ---- Site (used by the newsletter's links + Vercel) ----
SITE_URL=https://gift-times.vercel.app

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=The GIFT Times <onboarding@resend.dev>    # swap for your verified domain later
OWNER_EMAIL=you@example.com                          # where the daily digest-count alert is sent
# SEND_EMPTY=false                                    # set true to email even on quiet days
